{
  "schema_version": 1,
  "purpose": {
    "product_role": "polygon_weighted_operational_weather_features_for_weekly_disease_signal",
    "used_by_disease_model": true,
    "categorical_activity_thresholds_allowed": false,
    "personal_risk_interpretation_allowed": false,
    "data_status": "recent_operational_model_history_not_station_observations"
  },
  "source": {
    "provider": "Open-Meteo",
    "upstream_model_provider": "Deutscher Wetterdienst (DWD)",
    "endpoint": "https://api.open-meteo.com/v1/forecast",
    "model": "icon_seamless",
    "timezone": "UTC",
    "cell_selection": "nearest",
    "elevation": "nan",
    "hourly_variables": [
      "temperature_2m",
      "dew_point_2m",
      "precipitation",
      "soil_temperature_6cm",
      "soil_temperature_18cm",
      "soil_moisture_3_to_9cm",
      "soil_moisture_9_to_27cm"
    ],
    "model_feature_weeks": 4,
    "retrieval_history_weeks": 5,
    "batch_size": 50,
    "request_timeout_seconds": 60,
    "maximum_response_bytes_per_batch": 20000000,
    "user_agent": "KlopPodKlopjo/3.0 (+public precaution weather context)"
  },
  "spatial_contract": {
    "municipality_geometry_snapshot": "GURS_2026-04-04",
    "fixed_analytical_zones": true,
    "weights": "model_v3/outputs/weather/era5_land_municipality_grid_weights.csv",
    "weights_sha256": "d72c63087648ab21feb038b39102208db3b2767b931af535b3374f3c2be1ff00",
    "expected_municipality_count": 212,
    "expected_weight_row_count": 1043,
    "expected_unique_sample_point_count": 298,
    "maximum_returned_coordinate_shift_degrees": 0.2,
    "aggregation": "query_operational_model_at_frozen_grid_sample_points_then_apply_normalized_municipality_polygon_intersection_weights",
    "not_claimed": "not_native_model_grid_polygon_integration"
  },
  "freshness_contract": {
    "period": "five_complete_Monday_to_Sunday_UTC_weeks_strictly_before_signal_issue_week",
    "partial_current_day_allowed": false,
    "future_hours_allowed": false
  },
  "outputs": {
    "retrieval_root": "data/raw/open_meteo_activity_weather/retrievals",
    "municipality_weekly_weather": "municipality_weekly_weather.csv",
    "quality_summary": "quality_summary.json"
  }
}
