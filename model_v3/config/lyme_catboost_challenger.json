{
  "schema_version": 2,
  "inputs": {
    "population": "model_v3/outputs/canonical/population.csv",
    "weekly_cases": "model_v3/outputs/canonical/weekly_cases.csv",
    "weekly_weather": "model_v3/outputs/weather/era5_land_municipality_weekly.csv",
    "weather_quality_summary": "model_v3/outputs/weather/era5_land_weekly_quality_summary.json",
    "weather_contract": "model_v3/config/weather_data_contract.json",
    "validation_config": "model_v3/config/lyme_rolling_origin_validation.json",
    "validation_manifest": "model_v3/outputs/validation/lyme_rolling_origin_fold_manifest.csv",
    "baseline_fold_metrics": "model_v3/outputs/baselines/lyme_non_ml_fold_metrics.csv",
    "baseline_aggregate_metrics": "model_v3/outputs/baselines/lyme_non_ml_aggregate_metrics.csv",
    "statistical_config": "model_v3/config/lyme_seasonal_count_models.json",
    "statistical_fold_metrics": "model_v3/outputs/seasonal_count_models/lyme_seasonal_count_fold_metrics.csv",
    "statistical_aggregate_metrics": "model_v3/outputs/seasonal_count_models/lyme_seasonal_count_aggregate_metrics.csv",
    "weather_ablation_aggregate_metrics": "model_v3/outputs/weather_ablation/lyme_weather_ablation_aggregate_metrics.csv"
  },
  "reference": {
    "model_id": "model_s3_weather_offset_matched",
    "name": "S3 seasonality, municipality fixed effects, past incidence and lagged ERA5-Land weather with population exposure",
    "selection_reason": "matched_weather_aware_extension_of_prespecified_phase_9_s3_not_selected_by_phase_13_results",
    "target": "target_lyme_cases_next_4w",
    "target_window": "t_plus_1_through_t_plus_4",
    "population_rule": "reuse_phase_9_latest_present_year_strictly_before_issue_year",
    "allowed_information": [
      "municipality_code",
      "seasonal_sin_annual",
      "seasonal_cos_annual",
      "past_4w_lyme_incidence_per_100000",
      "21_training_fold_standardized_ERA5_Land_weather_features"
    ],
    "past_case_window": "t_minus_4_through_t_minus_1",
    "weather_windows": "lag_1_lag_2_and_previous_4_completed_weeks_t_minus_4_through_t_minus_1",
    "latest_information": "t_minus_1_completed_week",
    "weather_scaling": "training_fold_mean_and_standard_deviation_only",
    "common_training_support": "both_models_exclude_rows_without_complete_t_minus_4_through_t_minus_1_weather",
    "validation_support": "unchanged_phase_6_validation_rows_all_weather_complete",
    "weather_features_allowed": true,
    "static_geography_allowed": false,
    "static_geography_exclusion_reason": "municipality_area_is_exactly_collinear_with_municipality_fixed_effects_in_the_statistical_reference"
  },
  "challenger": {
    "challenger_id": "catboost_poisson_s3_weather_offset",
    "name": "CatBoost Poisson challenger with matched S3 and lagged ERA5-Land information",
    "implementation": "catboost.CatBoostRegressor",
    "loss_function": "Poisson",
    "prediction_type": "Exponent",
    "feature_columns": [
      "municipality_code",
      "seasonal_sin_annual",
      "seasonal_cos_annual",
      "past_4w_lyme_incidence_per_100000",
      "z_t2m_mean_c_lag_1w",
      "z_t2m_mean_c_lag_2w",
      "z_t2m_mean_c_previous_4w_mean",
      "z_d2m_mean_c_lag_1w",
      "z_d2m_mean_c_lag_2w",
      "z_d2m_mean_c_previous_4w_mean",
      "z_tp_sum_mm_lag_1w",
      "z_tp_sum_mm_lag_2w",
      "z_tp_sum_mm_previous_4w_sum",
      "z_stl1_mean_c_lag_1w",
      "z_stl1_mean_c_lag_2w",
      "z_stl1_mean_c_previous_4w_mean",
      "z_stl2_mean_c_lag_1w",
      "z_stl2_mean_c_lag_2w",
      "z_stl2_mean_c_previous_4w_mean",
      "z_swvl1_mean_m3_m3_lag_1w",
      "z_swvl1_mean_m3_m3_lag_2w",
      "z_swvl1_mean_m3_m3_previous_4w_mean",
      "z_swvl2_mean_m3_m3_lag_1w",
      "z_swvl2_mean_m3_m3_lag_2w",
      "z_swvl2_mean_m3_m3_previous_4w_mean"
    ],
    "feature_contract": "exactly_the_same_allowed_information_and_training_fold_weather_scaling_as_the_matched_statistical_reference",
    "categorical_features": [
      "municipality_code"
    ],
    "population_exposure": {
      "pool_baseline": "log(population_exposure_per_100000)",
      "population_exposure_per_100000": "population_divided_by_100000",
      "offset_coefficient": 1.0,
      "population_as_ordinary_feature": false,
      "same_selected_population_used_for_past_incidence": true
    },
    "ordering": {
      "row_order": "issue_week_then_municipality_code",
      "pool_timestamp": "issue_week_date_ordinal",
      "has_time": true
    },
    "parameters": {
      "iterations": 200,
      "depth": 6,
      "learning_rate": 0.05,
      "l2_leaf_reg": 3.0,
      "random_seed": 0,
      "random_strength": 1.0,
      "one_hot_max_size": 255,
      "thread_count": 1,
      "allow_writing_files": false,
      "task_type": "CPU",
      "verbose": false
    },
    "optimization": "single_prespecified_conservative_configuration_no_search_no_early_stopping",
    "validation_labels_passed_to_fit": false,
    "legacy_hyperparameters_reused": false
  },
  "metrics": {
    "mae": "mean_absolute_error",
    "rmse": "root_mean_squared_error",
    "poisson_deviance": "mean_poisson_deviance_only_when_all_prediction_observation_pairs_are_mathematically_valid",
    "difference_definition": "catboost_minus_matched_statistical_reference",
    "lower_is_better": true
  },
  "decision": {
    "numeric_materiality_threshold_prespecified": false,
    "automatic_promotion_allowed": false,
    "required_reporting": "aggregate_direction_fold_by_fold_direction_and_year_stability",
    "output_interpretation": "municipality_level_expected_reported_case_count_not_personal_risk"
  },
  "outputs": {
    "directory": "model_v3/outputs/catboost_challenger",
    "challenger_configuration": "lyme_catboost_challenger_configuration.json",
    "reference_fold_predictions": "lyme_matched_statistical_reference_fold_predictions.csv",
    "reference_fold_metrics": "lyme_matched_statistical_reference_fold_metrics.csv",
    "reference_aggregate_metrics": "lyme_matched_statistical_reference_aggregate_metrics.csv",
    "reference_fit_diagnostics": "lyme_matched_statistical_reference_fit_diagnostics.csv",
    "reference_coefficients": "lyme_matched_statistical_reference_coefficients.csv",
    "fold_predictions": "lyme_catboost_challenger_fold_predictions.csv",
    "fold_metrics": "lyme_catboost_challenger_fold_metrics.csv",
    "aggregate_metrics": "lyme_catboost_challenger_aggregate_metrics.csv",
    "development_comparison": "lyme_catboost_development_comparison.csv",
    "fold_differences": "lyme_catboost_vs_statistical_fold_differences.csv",
    "stability_summary": "lyme_catboost_stability_summary.csv",
    "fit_diagnostics": "lyme_catboost_challenger_fit_diagnostics.csv",
    "feature_importance": "lyme_catboost_challenger_feature_importance.csv",
    "quality_summary": "lyme_catboost_challenger_quality_summary.json"
  }
}
